{
  "name": "@scout/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./supabase": "./src/repositories/supabase/SupabaseRestResearchProjectRepository.ts",
    "./collection": "./src/repositories/supabase/SupabaseRestCollectionRunRepository.ts",
    "./ingestion": "./src/repositories/supabase/SupabaseRestListingIngestionRepository.ts",
    "./listings": "./src/repositories/supabase/SupabaseRestListingRepository.ts",
    "./observation-events": "./src/repositories/supabase/SupabaseRestObservationEventRepository.ts",
    "./text-analysis": "./src/repositories/supabase/SupabaseRestTextAnalysisRunRepository.ts",
    "./ebay-deletion": "./src/repositories/supabase/SupabaseRestEbayDeletionRepository.ts",
    "./valuation": "./src/repositories/supabase/SupabaseRestOpportunityValuationRepository.ts",
    "./repair-proposals": "./src/repositories/pg/PgRepairProposalRepository.ts",
    "./triage": "./src/repositories/supabase/SupabaseRestTriageDecisionRepository.ts",
    "./search-intelligence": "./src/repositories/supabase/SupabaseRestSearchQueryFamilyRepository.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "build": "tsc"
  },
  "dependencies": {
    "@scout/domain": "*",
    "@scout/schemas": "*",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0"
  }
}
