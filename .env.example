# Next.js Public Environment Variables
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_placeholder
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_placeholder
NEXT_PUBLIC_API_URL=http://localhost:8787

# API Gateway Secrets (Cloudflare Workers local secrets / .dev.vars)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your_supabase_anon_key_placeholder
WEB_ORIGIN=http://localhost:3000
# Required by the Marco 4 queue consumer; never use in browser or user CRUD/request routes.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_placeholder
# Mock is the safe default. Use sandbox or production only with a matching private keyset.
EBAY_CONNECTOR_MODE=mock
TEXT_ANALYZER_MODE=deterministic
EBAY_APP_ID_CLIENT_ID=your_ebay_app_id_client_id_placeholder
EBAY_CERT_ID_CLIENT_SECRET=your_ebay_cert_id_client_secret_placeholder
EBAY_MARKETPLACE_ID=EBAY_US
# Public Production webhook. Token must be 32-80 characters: letters, numbers, _ or -.
EBAY_NOTIFICATION_ENVIRONMENT=production
EBAY_ACCOUNT_DELETION_ENDPOINT_URL=https://api.example.com/webhooks/ebay/account-deletion
EBAY_DELETION_VERIFICATION_TOKEN=replace_with_a_random_32_to_80_character_token
# Stable 32+ character HMAC key for pseudonymous R2 seller prefixes. Do not rotate casually.
EBAY_IDENTITY_HASH_SECRET=replace_with_a_separate_random_secret_of_at_least_32_characters
# Keep unavailable unless an OAuth access token from Mercado Livre is explicitly configured.
ML_CONNECTOR_MODE=unavailable
ML_ACCESS_TOKEN=your_mercado_livre_oauth_access_token_placeholder
ML_CLIENT_ID=your_mercado_livre_client_id_placeholder
ML_CLIENT_SECRET=your_mercado_livre_client_secret_placeholder
ML_REFRESH_TOKEN=your_mercado_livre_refresh_token_placeholder
# Exact OAuth redirect registered in the Mercado Livre developer portal:
ML_OAUTH_REDIRECT_URI=https://eletrofy.com.br/oauth/mercadolivre/callback
GEMINI_API_KEY=your_gemini_api_key_placeholder

# Optional API Credentials
EXCHANGE_RATE_API_KEY=your_exchange_rate_key_placeholder
OPTIONAL_SCRAPING_PROVIDER_API_KEY=your_optional_scraping_provider_key_placeholder
